// DentaClub — adapted from the DentalOS schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  male
  female
  other
}

/// The appointment status machine, exactly as DentalOS defines it:
///   scheduled → confirmed → arrived → in_chair → completed
///   (cancelled / no_show are terminal side exits)
enum AppointmentStatus {
  scheduled
  confirmed
  arrived
  in_chair
  completed
  cancelled
  no_show
}

model Patient {
  id          String   @id @default(cuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  middleName  String?  @map("middle_name")
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  sex         Sex
  mobile      String?  @db.VarChar(20)
  email       String?
  address     String?
  occupation  String?
  /// single | married | widowed | separated
  civilStatus String?  @map("civil_status")
  referredBy  String?  @map("referred_by")
  notes       String?

  // Patient Information Record, Block A
  /// Jr. | Sr. | II | III | IV
  suffix             String? @db.VarChar(10)
  religion           String?
  nationality        String?
  homeOfficePhone    String? @map("home_office_phone") @db.VarChar(30)
  insuranceCarrier   String? @map("insurance_carrier")
  /// Free text, as written on the card: "01/01/2026 · GRP-48213".
  insuranceEffective String? @map("insurance_effective")
  chiefComplaint     String? @map("chief_complaint")
  /// For minors: the parent or guardian.
  guardianName       String? @map("guardian_name")
  guardianOccupation String? @map("guardian_occupation")
  guardianContact    String? @map("guardian_contact") @db.VarChar(30)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  odontogramEvents OdontogramEvent[]
  appointments     Appointment[]
  documents        Document[]
  consents         Consent[]
  medicalHistory   MedicalHistory?
  treatmentRecords TreatmentRecord[]

  /// Lets the alphabetical directory (A–Z by last name) read rows already sorted.
  @@index([lastName, firstName])
  @@map("patients")
}

/// The medical history from the clinic's paper dental record, one per patient.
/// Every answer is nullable: null means "not asked yet", which is different
/// from a recorded "No".
model MedicalHistory {
  id        String @id @default(cuid())
  patientId String @unique @map("patient_id")

  inGoodHealth Boolean? @map("in_good_health")

  // "Have you ever had any of the following?"
  rheumaticFever    Boolean? @map("rheumatic_fever")
  heartCondition    Boolean? @map("heart_condition")
  diabetes          Boolean?
  kidneyDisease     Boolean? @map("kidney_disease")
  highBloodPressure Boolean? @map("high_blood_pressure")
  anemia            Boolean?
  hepatitis         Boolean?
  asthma            Boolean?
  epilepsy          Boolean?

  hasAllergies         Boolean? @map("has_allergies")
  allergicToPenicillin Boolean? @map("allergic_to_penicillin")
  otherAllergies       String?  @map("other_allergies")

  takingMedicine      Boolean? @map("taking_medicine")
  underPhysicianCare  Boolean? @map("under_physician_care")
  physicianCareReason String?  @map("physician_care_reason")
  previousExtraction  String?  @map("previous_extraction")

  // "For women"
  pregnant       Boolean?
  bleeder        Boolean?
  onMenstruation Boolean? @map("on_menstruation")

  // Block B — dental history
  previousDentist   String? @map("previous_dentist")
  /// `YYYY-MM`
  lastDentalVisit   String? @map("last_dental_visit") @db.VarChar(7)
  /// low | moderate | severe
  dentalAnxiety     String? @map("dental_anxiety") @db.VarChar(10)
  flossingFrequency String? @map("flossing_frequency")

  // Block C — physician
  physicianName      String? @map("physician_name")
  physicianSpecialty String? @map("physician_specialty")
  physicianAddress   String? @map("physician_address")
  physicianPhone     String? @map("physician_phone") @db.VarChar(30)

  // Block C — questions 3–7 (1, 2 and 5 are in_good_health, under_physician_care, taking_medicine)
  seriousIllness       Boolean? @map("serious_illness")
  seriousIllnessDetail String?  @map("serious_illness_detail")
  hospitalized         Boolean?
  hospitalizedDetail   String?  @map("hospitalized_detail")
  medicationDetail     String?  @map("medication_detail")
  usesTobacco          Boolean? @map("uses_tobacco")
  usesDrugs            Boolean? @map("uses_drugs")
  drugsDetail          String?  @map("drugs_detail")

  // Block C — item 8, allergies (penicillin and "others" are above)
  allergicToLocalAnesthetic Boolean? @map("allergic_to_local_anesthetic")
  allergicToSulfa           Boolean? @map("allergic_to_sulfa")
  allergicToAspirin         Boolean? @map("allergic_to_aspirin")
  allergicToLatex           Boolean? @map("allergic_to_latex")

  // Block C — items 10–12 (9, bleeding time, is `bleeder`)
  nursing           Boolean?
  birthControlPills Boolean? @map("birth_control_pills")
  /// A+ | A- | B+ | B- | AB+ | AB- | O+ | O-
  bloodType         String?  @map("blood_type") @db.VarChar(3)
  bpSystolic        Int?     @map("bp_systolic") @db.SmallInt
  bpDiastolic       Int?     @map("bp_diastolic") @db.SmallInt

  /// Section 13 items that have no column above, by code (see routes/medical-history.ts).
  conditions      String[] @default([])
  otherConditions String?  @map("other_conditions")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_histories")
}

/// One row of the Treatment Record sheet. The sheet is saved whole, so rows
/// keep the order they were typed in (`position`). Balance is not stored: it is
/// the running total of charged minus paid, worked out from the rows above.
model TreatmentRecord {
  id              String    @id @default(cuid())
  patientId       String    @map("patient_id")
  position        Int       @db.SmallInt
  visitDate       DateTime? @map("visit_date") @db.Date
  teeth           String?   @db.VarChar(50)
  procedure       String?
  doctor          String?
  amountCharged   Decimal?  @map("amount_charged") @db.Decimal(10, 2)
  amountPaid      Decimal?  @map("amount_paid") @db.Decimal(10, 2)
  nextAppointment DateTime? @map("next_appointment") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, position])
  @@map("treatment_records")
}

/// The odontogram (tooth chart), ported from DentalOS. It is **append-only**:
/// rows are never updated or deleted. A mistake is fixed by writing a new event
/// that names the one it supersedes, so the history shows what was believed when.
///
/// The current chart is computed from these events (see services/odontogram.ts).
/// DB CHECK constraints in the migration enforce the supersession rules.
model OdontogramEvent {
  id            BigInt  @id @default(autoincrement())
  patientId     String  @map("patient_id")
  toothNumber   Int     @map("tooth_number") @db.SmallInt
  surfaces      Json?   @db.JsonB // ['M','O','D','B','L','I']; null = whole tooth
  /// condition | procedure | treatment
  eventType     String  @map("event_type")
  conditionCode String? @map("condition_code")
  notes         String?

  /// The event this one supersedes (FHIR `replaces`). Points new → old, always.
  replacesEventId    BigInt? @map("replaces_event_id")
  /// amendment | correction | entered-in-error (FHIR vocabulary)
  supersessionType   String? @map("supersession_type") @db.VarChar(20)
  /// Required for entered-in-error.
  supersessionReason String? @map("supersession_reason")

  /// Valid time — when the finding was true. Set explicitly for a past visit.
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)
  /// Transaction time — when it was recorded. Never back-dated.
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// Restrict, not SetNull: nulling the pointer would un-retract the old event.
  replaces     OdontogramEvent?  @relation("Supersession", fields: [replacesEventId], references: [id], onDelete: Restrict)
  supersededBy OdontogramEvent[] @relation("Supersession")

  @@index([patientId, toothNumber])
  @@index([patientId, observedAt])
  @@map("odontogram_events")
}

// ── Consent ─────────────────────────────────────────────────────────────
//
// One consent form for the whole clinic; its wording lives in
// backend/consent-form.txt. A patient signs it on the clinic's device, and the
// signing is kept as a Consent row plus an immutable PDF in `documents`.
// Signing again adds a new row — the latest one is the patient's current
// consent, and the older ones stay on file.

enum DocumentType {
  signed_consent
  other
}

/// One signing of the consent form. Never edited or deleted on its own.
model Consent {
  id                 String   @id @default(cuid())
  patientId          String   @map("patient_id")
  /// The form exactly as it was shown when signed, so later edits to
  /// consent-form.txt never change what this patient agreed to.
  formText           String   @map("form_text")
  /// The patient, or for a minor, the parent or guardian who signed.
  signerName         String   @map("signer_name")
  /// Set only when someone signs on the patient's behalf (e.g. "Mother").
  signerRelationship String?  @map("signer_relationship")
  /// `data:image/png;base64,…` from the signature pad.
  signatureImage     String   @map("signature_image")
  documentId         String   @unique @map("document_id")
  signedAt           DateTime @default(now()) @map("signed_at") @db.Timestamptz(6)

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: NoAction)

  @@index([patientId, signedAt])
  @@map("consents")
}

/// A patient document. A signed consent is written with `immutableFlag`: it is
/// a legal artifact and must not be editable afterwards.
///
/// DentalOS stores the file in Cloudflare R2 via an `attachments` table; here
/// the PDF bytes live in the row itself.
model Document {
  id            String       @id @default(cuid())
  patientId     String       @map("patient_id")
  type          DocumentType
  title         String
  fileData      Bytes?       @map("file_data")
  mimeType      String?      @map("mime_type")
  fileName      String?      @map("file_name")
  sizeBytes     Int?         @map("size_bytes")
  immutableFlag Boolean      @default(false) @map("immutable_flag")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consent Consent?

  @@index([patientId])
  @@map("documents")
}

// ── Scheduling (ported from DentalOS) ───────────────────────────────────

/// A clinic branch. Never deleted — deactivated, so years of appointments stay readable.
model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  operatories    Operatory[]
  availabilities ProviderAvailability[]

  @@map("locations")
}

/// A chair / treatment room. The chairside board groups today's patients by it.
model Operatory {
  id         String   @id @default(cuid())
  locationId String   @map("location_id")
  name       String
  color      String?  @db.VarChar(7)
  /// Left-to-right order on the chairside board.
  sortOrder  Int      @default(0) @map("sort_order") @db.SmallInt
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([locationId])
  @@map("operatories")
}

/// A dentist. DentalOS links this to a staff login (`user_id`) and reads the
/// name from there; with no logins here, the name lives on the profile.
model ProviderProfile {
  id              String   @id @default(cuid())
  name            String
  prcNumber       String?  @map("prc_number")
  specializations Json?    @db.JsonB
  colorHex        String   @default("#3B82F6") @map("color_hex") @db.VarChar(7)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  availabilities ProviderAvailability[]
  appointments   Appointment[]

  @@map("provider_profiles")
}

/// One weekly working window for a dentist at a location (Manila wall-clock).
model ProviderAvailability {
  id                String   @id @default(cuid())
  providerProfileId String   @map("provider_profile_id")
  locationId        String   @map("location_id")
  dayOfWeek         Int      @map("day_of_week") @db.SmallInt // 0=Sunday … 6=Saturday
  startTime         DateTime @map("start_time") @db.Time(0)
  endTime           DateTime @map("end_time") @db.Time(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  location Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, dayOfWeek])
  @@map("provider_availabilities")
}

model AppointmentType {
  id                   String   @id @default(cuid())
  name                 String
  durationMinutes      Int      @default(30) @map("duration_minutes") @db.SmallInt
  colorHex             String   @default("#6B7280") @map("color_hex") @db.VarChar(7)
  /// Lunch, meetings — time blocked out with no patient.
  isBlockTime          Boolean  @default(false) @map("is_block_time")
  recallIntervalMonths Int?     @map("recall_interval_months") @db.SmallInt
  /// The service's price in pesos; null when it has none (block time, or not yet set).
  /// Treatment rows copy it when charged, so changing it never rewrites past charges.
  price                Decimal? @db.Decimal(10, 2)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointments Appointment[]

  @@map("appointment_types")
}

model Appointment {
  id                String            @id @default(cuid())
  /// Nullable: a block-time slot (lunch) has no patient.
  patientId         String?           @map("patient_id")
  providerProfileId String            @map("provider_profile_id")
  appointmentTypeId String?           @map("appointment_type_id")
  operatoryId       String?           @map("operatory_id")
  status            AppointmentStatus @default(scheduled)

  scheduledStart DateTime  @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd   DateTime  @map("scheduled_end") @db.Timestamptz(6)
  /// Set on → in_chair.
  actualStart    DateTime? @map("actual_start") @db.Timestamptz(6)
  /// Set on → completed.
  actualEnd      DateTime? @map("actual_end") @db.Timestamptz(6)

  cancellationReason String? @map("cancellation_reason")
  notes              String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient         Patient?         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider        ProviderProfile  @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  appointmentType AppointmentType? @relation(fields: [appointmentTypeId], references: [id], onDelete: SetNull)
  operatory       Operatory?       @relation(fields: [operatoryId], references: [id], onDelete: SetNull)

  // Drives the day/week calendar and the chairside board.
  @@index([scheduledStart])
  @@index([operatoryId, scheduledStart])
  @@index([providerProfileId, scheduledStart])
  @@index([patientId])
  @@map("appointments")
}

// ── Sign-in ─────────────────────────────────────────────────────────────

/// admin: everything, including Settings (services, dentists, chairs).
/// staff: the front desk only (dashboard, appointments, patients).
enum UserRole {
  admin
  staff
}

/// Someone who can sign in. Accounts are made, and passwords set, on the
/// clinic computer with `npm run set-password`.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  role         UserRole @default(staff)
  /// scrypt hash: `scrypt$<salt>$<hash>`. The password itself is never stored.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}
